# Render's build ran `corepack enable` with no version pin, which fetched a pnpm new enough to
# enforce `minimumReleaseAge` by default: it refuses any package published within the last 24
# hours. Several of our pinned dependencies were published the day this project was created, so
# every build failed until they aged out — a build that passes or fails depending on the clock.
#
# Turning the heuristic off is safe here specifically because pnpm-lock.yaml is committed and
# carries an integrity hash for every package: the build installs the exact bytes that were
# resolved and tested, not "whatever is newest". The age check guards against unpinned installs,
# which this is not.
minimum-release-age=0
