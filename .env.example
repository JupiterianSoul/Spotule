# ─────────────────────────────────────────────────────────────
# SpotiMax — environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# --- Spotify developer app (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Must match EXACTLY one of the Redirect URIs registered on the Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# --- App URLs ---
APP_ENV=development
API_BASE_URL=http://127.0.0.1:8000
WEB_BASE_URL=http://127.0.0.1:3000
# Comma-separated list of origins allowed to call the API with cookies
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Security ---
# 32+ random bytes, base64. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Fernet key used to encrypt Spotify refresh/access tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me
SESSION_COOKIE_NAME=spotimax_session
SESSION_TTL_SECONDS=2592000
COOKIE_SECURE=false

# --- Data stores ---
DATABASE_URL=postgresql+asyncpg://spotimax:spotimax@localhost:5432/spotimax
DATABASE_URL_SYNC=postgresql+psycopg://spotimax:spotimax@localhost:5432/spotimax
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Workers / ingestion ---
RECENTLY_PLAYED_POLL_SECONDS=300
SKIP_GUARD_HEARTBEAT_SECONDS=4
SKIP_GUARD_MAX_ACTIVE_USERS=25
IMPORT_UPLOAD_DIR=./uploads
IMPORT_MAX_UPLOAD_MB=512

# --- Frontend (Next.js reads NEXT_PUBLIC_* at build time) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en
