# ─────────────────────────────────────────────────────────────
# Spotule — environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# --- Spotify developer app (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Must match EXACTLY one of the Redirect URIs registered on the Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# --- App URLs ---
APP_ENV=development
API_BASE_URL=http://127.0.0.1:8000
WEB_BASE_URL=http://127.0.0.1:3000
# Only used if the browser talks to the API on a different origin. By default the Next app
# proxies /api/* to FastAPI (see frontend/next.config.mjs), so this stays as-is.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Security ---
# 32+ random bytes, base64. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Fernet key used to encrypt Spotify refresh/access tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me
SESSION_COOKIE_NAME=spotule_session
# Shared secret for the scheduler endpoints (/api/v1/cron/*), used when you run without a
# Celery worker. Leave empty to disable those endpoints entirely.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
CRON_SECRET=
SESSION_TTL_SECONDS=2592000
COOKIE_SECURE=false

# --- Data stores ---
DATABASE_URL=postgresql+asyncpg://spotule:spotule@localhost:5432/spotule
DATABASE_URL_SYNC=postgresql+psycopg://spotule:spotule@localhost:5432/spotule
# "auto" detects Supabase/PgBouncer style URLs and adjusts asyncpg accordingly; "on"/"off" force it.
DB_POOLER_MODE=auto
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Workers / ingestion ---
RECENTLY_PLAYED_POLL_SECONDS=300
SKIP_GUARD_HEARTBEAT_SECONDS=4
SKIP_GUARD_MAX_ACTIVE_USERS=25
IMPORT_UPLOAD_DIR=./uploads
IMPORT_MAX_UPLOAD_MB=512

# --- Frontend ---
# Where the Next server forwards /api/* (server-side only, never sent to the browser).
API_INTERNAL_URL=http://127.0.0.1:8000
# Leave EMPTY so the browser uses same-origin /api/* and the session cookie stays first-party.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DEFAULT_LOCALE=en
